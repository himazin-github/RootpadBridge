# Normalize line endings so the repository stays consistent across platforms.
# Text files are stored with LF in the repository.
* text=auto eol=lf

# Windows scripts must keep CRLF so they run correctly on Windows.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.jar binary
*.apk binary
*.keystore binary
*.jks binary

# The root daemon executable is a compiled ELF binary.
rootpad_d binary
