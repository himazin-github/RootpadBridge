<?xml version="1.0" encoding="utf-8"?>
<!-- ランチャー アイコンの背景: 暗色グラデーション + アクセント -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF1A2430" />
                <item android:offset="0.55" android:color="#FF101720" />
                <item android:offset="1" android:color="#FF0B1016" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 右上のアクセントグロー -->
    <path android:pathData="M108,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="86"
                android:centerY="22"
                android:gradientRadius="70">
                <item android:offset="0" android:color="#331DB954" />
                <item android:offset="1" android:color="#001DB954" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
